# Google Gemini API
GOOGLE_API_KEY=AIza...

# FMCSA SAFER API
FMCSA_WEB_KEY=your-fmcsa-web-key

# Model selection
ORACLE_MODEL=gemini-flash-latest
AGENT_MODEL=gemini-flash-lite-latest

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# API
API_HOST=0.0.0.0
API_PORT=8000

# Observability
LOG_LEVEL=INFO
TRACE_ENABLED=true
TRACE_DIR=./evals/results
